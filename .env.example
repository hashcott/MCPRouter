# Required. No defaults — the process exits 78 if any is missing.
DATABASE_URL=postgres://mcprouter:mcprouter@localhost:5432/mcprouter
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
PUBLIC_URL=http://localhost:3000

# Optional, shown with their defaults.
PORT=3000
LOG_LEVEL=info
# LOG_FILE=/var/log/mcprouter/app.log
MIGRATE_ON_BOOT=true
SHUTDOWN_TIMEOUT_MS=10000

# Every secret above also accepts a mounted-file form, e.g.:
# AUTH_SECRET_FILE=/run/secrets/auth_secret
